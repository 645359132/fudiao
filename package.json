{
  "name": "fudiao",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --parallel --aggregate-output typecheck",
    "lint": "eslint .",
    "depcheck": "depcruise packages apps",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm depcheck && pnpm test",
    "m0": "tsx apps/m0-cli/src/main.ts",
    "m3:eval": "tsx tools/m3-eval/main.ts",
    "assistant:eval": "tsx tools/assistant-eval/main.ts",
    "prompts:build": "tsx tools/prompts/build-templates.ts",
    "bench": "tsx tools/bench/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fudiao/shared": "workspace:*",
    "@fudiao/store": "workspace:*",
    "@types/node": "^22.20.5",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
