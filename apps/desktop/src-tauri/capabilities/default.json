{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口的权限：核心默认权限；关闭窗口前先保存，保存后由界面销毁窗口；标题栏随作者选的外观变为浅色或深色；选择作品文件夹的对话框。导出的保存对话框由 Rust 弹出，不开放给界面。",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-set-theme",
    "dialog:allow-open"
  ]
}
